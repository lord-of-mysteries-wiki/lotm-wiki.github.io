body
  margin 0
  background #101522
  color #d9d9d1
  font-family Georgia, 'Songti SC', serif
  line-height 1.8
a
  color #d9c69d
  text-decoration none
a:hover
  text-decoration underline
.site-nav
  display flex
  align-items center
  justify-content space-between
  gap 24px
  flex-wrap wrap
  padding 20px 6%
  border-bottom 1px solid #414657
.site-title
  font-size 20px
  font-weight bold
.nav-links
  display flex
  gap 20px
  flex-wrap wrap
  font-size 14px
.main-content
  max-width 1000px
  margin 0 auto
  padding 30px 6% 70px
.hero
  padding 70px 0
  border-bottom 1px solid #414657
.hero h1
  font-size 42px
  color #f1ead9
.eyebrow
  color #bda982
  letter-spacing .2em
  font-size 12px
.button
  display inline-block
  margin-top 20px
  padding 9px 18px
  border 1px solid #bca983
.entry
  border-bottom 1px solid #414657
  padding 10px 0
.site-footer
  padding 24px 6%
  border-top 1px solid #414657
  color #9399a5
  font-size 12px
