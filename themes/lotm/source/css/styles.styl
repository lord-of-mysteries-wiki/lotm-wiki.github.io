*
  box-sizing border-box
body
  margin 0
  background #292e40
  color #d7dbed
a
  color #a8dfd7
  text-decoration none
a:hover
  color #d0f3ed
.main-content
  max-width 1060px
  margin 0 auto
  padding 48px 28px 80px
.hero
  position relative
  overflow hidden
  padding 70px 64px
  border 1px solid #41495e
  border-radius 16px
  background radial-gradient(ellipse at 75% 25%, #3b4b5e 0%, #30374c 38%, #272d40 100%)
.hero h1
  margin 12px 0
  font-weight 500
  color #e4e6f3
.button
  display inline-block
  margin-top 20px
  padding 10px 18px
  border 1px solid #73b8b9
  border-radius 8px
  background #334b55
  color #c1eeea
.button:hover
  background #405e66
.main-content h2
  color #e2e5f0

.home-hero
  position relative
  overflow hidden
  min-height 300px
  display flex
  align-items center
  padding 56px 64px
  border 1px solid #414b60
  border-radius 16px
  background radial-gradient(ellipse at 80% 45%, #40576a 0%, #30394d 36%, #232a3c 100%)
.home-hero-copy
  position relative
  z-index 1
.home-eyebrow
  color #98c8c5
  font 600 .75rem/1.4 sans-serif
  letter-spacing .18em
.home-hero h1
  margin 18px 0 26px
  color #edf0f7
.home-primary
  display inline-block
  padding 11px 18px
  border 1px solid #8abfbd
  border-radius 8px
  background #344d56
  color #e0f5f1
  font-family sans-serif
.home-primary:hover
  background #42616a
.home-constellation
  position absolute
  width 290px
  height 290px
  right 8%
  top 50%
  transform translateY(-50%) rotate(-18deg)
  border 1px solid rgba(168,223,215,.22)
  border-radius 50%
  box-shadow 0 0 0 38px rgba(168,223,215,.025), inset 0 0 60px rgba(168,223,215,.05)
.home-constellation::before,.home-constellation::after
  content ''
  position absolute
  inset 35px
  border 1px solid rgba(168,223,215,.19)
  border-radius 50%
.home-constellation::after
  inset 82px
.home-constellation i
  position absolute
  width 8px
  height 8px
  border-radius 50%
  background #b4e7dc
  box-shadow 0 0 16px #a3e6da
.home-constellation i:nth-child(1)
  top 12%; left 18%
.home-constellation i:nth-child(2)
  top 6%; right 30%
.home-constellation i:nth-child(3)
  top 40%; right -4px
.home-constellation i:nth-child(4)
  bottom 9%; right 22%
.home-constellation i:nth-child(5)
  bottom 23%; left 5%
.home-constellation i:nth-child(6)
  top 47%; left 48%
.home-section
  margin-top 46px
.home-section-heading
  display flex
  justify-content space-between
  align-items baseline
  margin-bottom 16px
  font-family sans-serif
.home-section-heading h2
  margin 0
.home-section-heading span
  color #8797aa
  font-size .75rem
  letter-spacing .15em
.home-grid,.home-people
  display grid
  grid-template-columns repeat(3, minmax(0,1fr))
  gap 12px
.home-card,.home-person
  display flex
  align-items center
  gap 16px
  padding 20px
  border 1px solid #40485c
  border-radius 12px
  background #252b3d
  color #e1e7ef
  font-family sans-serif
  transition background .2s, border-color .2s
.home-card:hover,.home-person:hover
  border-color #78b5b4
  background #303b4c
.home-card-icon,.home-person-mark
  flex none
  display grid
  place-items center
  width 46px
  height 46px
  border 1px solid #536b76
  border-radius 12px
  color #a7d8d2
  background #303f4c
  font-size 1.35rem
.home-person-mark
  border-radius 50%
  font-family serif
  background linear-gradient(145deg,#66798b,#323e56)
.home-card strong,.home-person strong
  display block
  font-size 1rem
.home-card small,.home-person small
  display block
  margin-top 5px
  color #aab6c8
  font-size .875rem
@media (max-width: 700px)
  .home-hero
    min-height 250px
    padding 36px 24px
  .home-constellation
    right -110px
    opacity .55
  .home-grid
    grid-template-columns repeat(2, minmax(0,1fr))
  .home-people
    grid-template-columns 1fr
  .home-card
    align-items flex-start
    flex-direction column
    padding 16px
  .home-section
    margin-top 32px

.article
  padding 32px
  border 1px solid #3a4054
  border-radius 12px
  background #222637
.site-footer
  padding 24px 28px
  border-top 1px solid #3a4054
  color #929ab4
@media (max-width: 800px)
  .main-content
    padding 28px 16px 56px
  .hero
    padding 42px 24px
  .article
    padding 24px

// 词条表格：长表可横向滚动，避免列被挤成竖排。
.article
  min-width 0
  overflow-wrap anywhere
.article table
  display block
  width 100%
  max-width 100%
  margin 1.5rem 0 2rem
  overflow-x auto
  border-collapse separate
  border-spacing 0
  line-height 1.65
  scrollbar-width thin
  scrollbar-color #69748b #252b3b
.article thead th
  padding 13px 16px
  background #343c50
  color #e7eaf4
  font-weight 600
  text-align left
  white-space nowrap
  border-bottom 1px solid #56617a
.article tbody td
  padding 14px 16px
  vertical-align top
  background #292f41
  color #d3d9e8
  border-bottom 1px solid #41495e
  overflow-wrap break-word
.article tbody tr:nth-child(even) td
  background #2d3447
.article tbody tr:hover td
  background #353e51
.article tbody tr:last-child td
  border-bottom 0
.article table th:first-child, .article table td:first-child
  padding-left 18px
.article table th:last-child, .article table td:last-child
  padding-right 18px
.article table th
  min-width 90px
.article table td
  min-width 90px
.article table:has(th:nth-child(4):last-child) th:nth-child(3),
.article table:has(th:nth-child(4):last-child) td:nth-child(3)
  min-width 220px
.article table:has(th:nth-child(4):last-child) th:nth-child(4),
.article table:has(th:nth-child(4):last-child) td:nth-child(4)
  min-width 280px
.article table:has(th:nth-child(5)) td
  min-width 90px
.article table a
  color #9fe0d7
  text-decoration underline
  text-decoration-color #628b8e
  text-underline-offset 3px
@media (max-width: 800px)
  .article table
    margin 1.25rem 0 1.75rem
  .article thead th, .article tbody td
    padding 12px

.article .pathway-groups tbody th
  min-width 110px
  padding 14px 18px
  vertical-align middle
  text-align left
  color #c8e6df
  background #303c49
  border-bottom 1px solid #56617a
  border-right 1px solid #485668
  white-space nowrap
.article .pathway-groups tbody:last-child th
  border-bottom 0

// 事件词条统一展示时间依据；未考证时不显示此区块。
.event-time
  margin 1.5rem 0 2rem
  padding 1rem 1.25rem
  border-left 3px solid #78b8b4
  border-radius 0 8px 8px 0
  background #2d3948
.event-time h2
  margin 0 0 .5rem
.event-time p
  margin .4rem 0
  font-size var(--text-body)

// 反馈表单
.feedback-form
  max-width 680px
  margin 2rem 0
  display grid
  gap 1.4rem
.feedback-field
  display grid
  gap .5rem
.feedback-field label
  color #e4e6f3
  font-family sans-serif
  font-weight 600
.feedback-field input, .feedback-field textarea
  width 100%
  padding .8rem 1rem
  border 1px solid #555f75
  border-radius 8px
  background #292f42
  color #e4e6f3
  font inherit
  line-height 1.6
.feedback-field textarea
  resize vertical
.feedback-field input:focus, .feedback-field textarea:focus
  outline 2px solid #a8dfd7
  outline-offset 2px
.feedback-field input::placeholder, .feedback-field textarea::placeholder
  color #9aa4b9
.feedback-form button
  justify-self start
  padding .75rem 1.25rem
  border 1px solid #73b8b9
  border-radius 8px
  background #334b55
  color #d3f4f0
  font inherit
  font-family sans-serif
  cursor pointer
.feedback-form button:hover
  background #405e66
.feedback-form button:focus-visible
  outline 2px solid #a8dfd7
  outline-offset 2px
.feedback-note
  margin 0
  color #b3bbce
  font-size .9em
.feedback-form button:disabled
  opacity .55
  cursor not-allowed
