*
  box-sizing border-box
body
  margin 0
  background var(--ui-page)
  color var(--ui-ink)
a
  color var(--ui-accent)
  text-decoration none
a:hover
  color var(--ui-accent)
.main-content
  max-width 1060px
  margin 0 auto
  padding 48px 28px 80px
.hero
  position relative
  overflow hidden
  padding 70px 64px
  border 1px solid var(--ui-hover)
  border-radius 16px
  background radial-gradient(ellipse at 75% 25%, var(--ui-hover) 0%, var(--ui-hover) 38%, var(--ui-surface) 100%)
.hero h1
  margin 12px 0
  font-weight 500
  color var(--ui-ink)
.button
  display inline-block
  margin-top 20px
  padding 10px 18px
  border 1px solid var(--ui-muted)
  border-radius 8px
  background var(--ui-hover)
  color var(--ui-accent)
.button:hover
  background var(--ui-line)
.main-content h2
  color var(--ui-ink)

.home-hero
  position relative
  overflow hidden
  min-height 300px
  display flex
  align-items center
  padding 56px 64px
  border 1px solid var(--ui-hover)
  border-radius 16px
  background radial-gradient(ellipse at 80% 45%, var(--ui-line) 0%, var(--ui-hover) 36%, var(--ui-surface) 100%)
.home-hero-copy
  position relative
  z-index 1
.home-eyebrow
  color var(--ui-accent)
  font 600 var(--text-meta)/1.4 var(--font-ui)
  letter-spacing .18em
.home-hero h1
  margin 18px 0 26px
  color var(--ui-ink)
.home-primary
  display inline-block
  padding 11px 18px
  border 1px solid var(--ui-accent)
  border-radius 8px
  background var(--ui-hover)
  color var(--ui-accent)
  font-family sans-serif
.home-primary:hover
  background var(--ui-line)
.home-constellation
  position absolute
  width 290px
  height 290px
  right 8%
  top 50%
  transform translateY(-50%) rotate(-18deg)
  border 1px solid rgba(168,223,215,.22)
  border-radius 50%
  box-shadow 0 0 0 38px rgba(168,223,215,.025), inset 0 0 60px rgba(168,223,215,.05)
.home-constellation::before,.home-constellation::after
  content ''
  position absolute
  inset 35px
  border 1px solid rgba(168,223,215,.19)
  border-radius 50%
.home-constellation::after
  inset 82px
.home-constellation i
  position absolute
  width 8px
  height 8px
  border-radius 50%
  background var(--ui-accent)
  box-shadow 0 0 16px var(--ui-accent)
.home-constellation i:nth-child(1)
  top 12%; left 18%
.home-constellation i:nth-child(2)
  top 6%; right 30%
.home-constellation i:nth-child(3)
  top 40%; right -4px
.home-constellation i:nth-child(4)
  bottom 9%; right 22%
.home-constellation i:nth-child(5)
  bottom 23%; left 5%
.home-constellation i:nth-child(6)
  top 47%; left 48%
.home-section
  margin-top 46px
.home-section-heading
  display flex
  justify-content space-between
  align-items baseline
  margin-bottom 16px
  font-family sans-serif
.home-section-heading h2
  margin 0
.home-section-heading span
  color var(--ui-muted)
  font-size var(--text-meta)
  letter-spacing .15em
.home-grid,.home-people
  display grid
  grid-template-columns repeat(3, minmax(0,1fr))
  gap 12px
.home-card,.home-person
  display flex
  align-items center
  gap 16px
  padding 20px
  border 1px solid var(--ui-hover)
  border-radius 12px
  background var(--ui-surface)
  color var(--ui-ink)
  font-family sans-serif
  transition background .2s, border-color .2s
.home-card:hover,.home-person:hover
  border-color var(--ui-accent)
  background var(--ui-hover)
.home-card-icon,.home-person-mark
  flex none
  display grid
  place-items center
  width 46px
  height 46px
  border 1px solid var(--ui-line)
  border-radius 12px
  color var(--ui-accent)
  background var(--ui-hover)
  font-size 1.35rem
.home-person-mark
  border-radius 50%
  font-family serif
  background linear-gradient(145deg,var(--ui-line),var(--ui-hover))
.home-card strong,.home-person strong
  display block
  font 600 var(--text-body)/1.45 var(--font-ui)
.home-card small,.home-person small
  display block
  margin-top 5px
  color var(--ui-muted)
  font-size var(--text-ui)
@media (max-width: 700px)
  .home-hero
    min-height 250px
    padding 36px 24px
  .home-constellation
    right -110px
    opacity .55
  .home-grid
    grid-template-columns repeat(2, minmax(0,1fr))
  .home-people
    grid-template-columns 1fr
  .home-card
    align-items flex-start
    flex-direction column
    padding 16px
  .home-section
    margin-top 32px

.article
  padding 32px
  border 1px solid var(--ui-hover)
  border-radius 12px
  background var(--ui-panel)
.site-footer
  padding 24px 28px
  border-top 1px solid var(--ui-hover)
  color var(--ui-muted)
@media (max-width: 800px)
  .main-content
    padding 28px 16px 56px
  .hero
    padding 42px 24px
  .article
    padding 24px

// 正文数据表由内容决定列宽；窄屏仅在表内横向滚动。
.article
  min-width 0
  overflow-wrap anywhere
.article table
  width 100%
  max-width 100%
  margin 1rem 0 1.5rem
  border-collapse collapse
.article th, .article td
  padding .55rem .75rem
  text-align left
  vertical-align top
  border-bottom 1px solid var(--ui-hover)
  overflow-wrap break-word
.article thead th
  background var(--ui-surface)
  font-weight 600
.article .pathway-groups tbody th
  vertical-align middle
  color var(--ui-accent)
@media (max-width: 800px)
  .article table
    display block
    overflow-x auto
  .article th, .article td
    padding .45rem .55rem
    min-width 3.5em

// 事件词条统一展示时间依据；未考证时不显示此区块。
.event-time
  margin 1.5rem 0 2rem
  padding 1rem 1.25rem
  border-left 3px solid var(--ui-accent)
  border-radius 0 8px 8px 0
  background var(--ui-hover)
.event-time h2
  margin 0 0 .5rem
.event-time p
  margin .4rem 0
  font-size var(--text-body)

// 反馈表单
.feedback-form
  max-width 680px
  margin 2rem 0
  display grid
  gap 1.4rem
.feedback-field
  display grid
  gap .5rem
.feedback-field label
  color var(--ui-ink)
  font-family sans-serif
  font-weight 600
.feedback-field input, .feedback-field textarea
  width 100%
  padding .8rem 1rem
  border 1px solid var(--ui-line)
  border-radius 8px
  background var(--ui-surface)
  color var(--ui-ink)
  font inherit
  line-height 1.6
.feedback-field textarea
  resize vertical
.feedback-field input:focus, .feedback-field textarea:focus
  outline 2px solid var(--ui-accent)
  outline-offset 2px
.feedback-field input::placeholder, .feedback-field textarea::placeholder
  color var(--ui-muted)
.feedback-form button
  justify-self start
  padding .75rem 1.25rem
  border 1px solid var(--ui-muted)
  border-radius 8px
  background var(--ui-hover)
  color var(--ui-accent)
  font inherit
  font-family sans-serif
  cursor pointer
.feedback-form button:hover
  background var(--ui-line)
.feedback-form button:focus-visible
  outline 2px solid var(--ui-accent)
  outline-offset 2px
.feedback-note
  margin 0
  color var(--ui-muted)
  font-size var(--text-ui)
.feedback-form button:disabled
  opacity .55
  cursor not-allowed

.pathway-heading
  padding-bottom 28px
  border-bottom 1px solid var(--ui-line)
.pathway-heading h1
  margin 10px 0 20px
.pathway-workspace
  display grid
  grid-template-columns 170px minmax(0, 1fr)
  gap 44px
  margin-top 32px
.pathway-sequences
  position sticky
  top 28px
  align-self start
  font-family sans-serif
.pathway-sequences label
  display block
  color var(--ui-muted)
  font-size var(--text-ui)
  margin-bottom 12px
.pathway-sequences select
  display none
.pathway-sequences ol
  list-style none
  margin 0
  padding 0
.pathway-sequences a
  display flex
  align-items center
  gap 12px
  padding 9px 10px
  border-left 2px solid transparent
  color var(--ui-muted)
.pathway-sequences a[aria-current]
  color var(--ui-ink)
  border-color var(--pathway-primary)
  background var(--ui-hover)
.pathway-sequences a span
  opacity .65
  font-size var(--text-ui)
.pathway-sequence
  scroll-margin-top 110px
  padding 0 0 38px
  margin-bottom 38px
  border-bottom 1px solid var(--ui-line)
.pathway-sequence h2
  display flex
  align-items center
  gap 18px
  margin-top 0
.pathway-level
  color var(--ui-muted)
  font-size inherit
  font-weight 400
.pathway-sequence h3
  margin-top 26px
.pathway-sequence p
  overflow-wrap anywhere
.pathway-chapters
  min-width 0
@media (max-width: 700px)
  .pathway-workspace
    display block
    margin-top 0
  .pathway-sequences
    top 0
    z-index 5
    background var(--ui-page)
    padding 12px 0
    margin-bottom 24px
  .pathway-sequences label, .pathway-sequences ol
    display none
  .pathway-sequences select
    display block
    width 100%
    background var(--ui-hover)
    color var(--ui-ink)
    border 1px solid var(--ui-muted)
    border-radius 5px
    padding 10px
    font inherit
.pathway-sequence li + li
  margin-top 10px
.pathway-citation
  font-family sans-serif
  font-size var(--text-meta)
  margin-left .3em

// Shared full-viewport historical map workspace.
.world-map
  --map-border var(--ui-hover)
  color var(--ui-ink)
.world-map button,.world-map select
  color inherit
  background var(--ui-surface)
  border 1px solid var(--map-border)
  border-radius 8px
.world-map button
  cursor pointer
  min-height 36px
  min-width 36px
.world-map button:hover,.world-map button.is-selected
  color var(--ui-accent)
  border-color var(--ui-accent)
  background var(--ui-hover)
.world-map button:disabled
  opacity .35
  cursor default
.world-map :focus-visible
  outline 2px solid var(--ui-accent)
  outline-offset 3px
.map-timebar
  min-height 60px
  display flex
  align-items flex-start
  gap 14px
  padding 4px 28px
  background var(--ui-surface)
  border-bottom 1px solid var(--map-border)
.map-timebar > button
  min-width 32px
  min-height 32px
  margin-top 9px
  box-sizing border-box
  width 32px
  height 32px
  flex 0 0 32px
.map-slider
  position relative
  flex 1
  min-width 60px
  height 52px
  margin 0 24px
.map-slider input
  display block
  width 100%
  height 34px
  margin 9px 0 0
  accent-color var(--ui-accent)
  cursor pointer
.map-ticks
  position absolute
  left 7px
  right 7px
  top 38px
  height 14px
  color var(--ui-muted)
  font-variant-numeric tabular-nums
.map-ticks > span
  position absolute
  white-space nowrap
  max-width 100%
  overflow visible
  transform translateX(-50%)
  text-align center
  line-height 14px
.map-era-band
  position absolute
  top 0
  left 7px
  right 7px
  height 18px
  display grid
  grid-template-columns repeat(6, minmax(0, 1fr))
  box-sizing border-box
  color var(--ui-muted)
  font-size var(--text-meta)
  line-height 16px
  text-align center
.map-era-band > span
  min-width 0
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
.map-track-segments
  position absolute
  top 19px
  left 7px
  right 7px
  height 7px
  display grid
  grid-template-columns repeat(6, minmax(0, 1fr))
  pointer-events none
  border-left 1px solid var(--ui-line)
  border-right 1px solid var(--ui-line)
  box-sizing border-box
.map-track-segments > span + span
  border-left 1px solid var(--ui-line)
.map-era-band .is-current
  color var(--ui-accent)
  font-weight 600
.map-ticks > span
  font-size var(--text-meta)
.map-ticks .is-current
  color var(--ui-accent)
  font-weight 600
.map-ticks > span[hidden]
  display none
.map-ticks
  pointer-events none
.map-ticks > span::before
  content ''
  position absolute
  left 50%
  top -15px
  width 6px
  height 6px
  border-radius 50%
  background var(--ui-muted)
  transform translateX(-50%)
.map-ticks > span.is-current::before
  background var(--ui-accent)
.map-workspace
  display grid
  grid-template-columns minmax(0,1fr) 300px
  gap 12px
  padding 14px
  box-sizing border-box
  height calc(100dvh - 128px)
  min-height 0
.map-canvas,.map-panel
  border 1px solid var(--map-border)
  border-radius 12px
  background var(--ui-surface)
.map-canvas
  position relative
  min-width 0
  overflow hidden
  background radial-gradient(ellipse at 50% 38%,var(--ui-hover),var(--ui-surface) 80%)
.map-svg
  display block
  width 100%
  height 100%
  box-sizing border-box
  padding 0
  touch-action none
  user-select none
  cursor grab
.map-svg:active
  cursor grabbing
.map-coasts path
  fill var(--ui-hover)
  stroke none
.map-region
  cursor pointer
.map-region path
  fill var(--region-color, #a8dfd7)
  fill-opacity .16
  stroke none
  transition fill-opacity .18s
.map-region[data-inferred] path
  fill-opacity .25
.map-region[data-inferred].is-selected path
  fill-opacity .38
.map-region text
  fill var(--ui-ink)
  pointer-events none
.map-region.is-selected path
  fill-opacity .34

.map-region.is-selected text
  fill var(--ui-accent)
.map-geographic-labels, .map-geographic-label
  fill var(--ui-muted)
  pointer-events none
  letter-spacing .22em
.map-zoom
  position absolute
  right 18px
  bottom 15px
  display flex
  gap 7px
.map-panel
  padding 24px
  overflow-y auto
.map-panel h2
  margin 0 0 10px
  font-weight 500
.map-panel p
  margin 10px 0
.map-muted,.map-panel details
  color var(--ui-muted)
.map-panel details
  margin-top 18px
.map-panel summary
  cursor pointer
.map-panel .button
  margin 8px 0
.map-panel a
  overflow-wrap anywhere
@media(max-width:1100px)
  .map-workspace
    grid-template-columns minmax(0,1fr) 260px
  .map-panel
    padding 18px
@media(max-width:800px)
  .map-timebar
    min-height 60px
    gap 6px
    padding 4px 12px
  .map-slider
    margin 0 20px
  .map-workspace
    display block
    height auto
    min-height 0
    padding 10px
  .map-canvas
    height calc(100dvh - 134px)
    min-height 0
  .map-panel
    margin-top 10px
    overflow visible
    padding 20px
  .map-zoom
    right 10px

@media(prefers-reduced-motion:reduce)
  .map-region path
    transition none
.map-slider input[type=range]
  appearance none
  -webkit-appearance none
  height 34px
  background transparent
.map-slider input[type=range]::-webkit-slider-runnable-track
  height 3px
  border-radius 2px
  background var(--ui-line)
.map-slider input[type=range]::-moz-range-track
  height 3px
  border-radius 2px
  background var(--ui-line)
.map-slider input[type=range]::-webkit-slider-thumb
  appearance none
  -webkit-appearance none
  width 14px
  height 14px
  margin-top -5.5px
  border-radius 50%
  background var(--ui-accent)
  border 2px solid var(--ui-hover)
  box-shadow 0 0 0 1px var(--ui-accent)
.map-slider input[type=range]::-moz-range-thumb
  width 12px
  height 12px
  border-radius 50%
  background var(--ui-accent)
  border 2px solid var(--ui-hover)
.map-region:focus
  outline none
.map-region:focus-visible path
  fill-opacity .45
.map-boundaries
  pointer-events none
.map-boundaries path
  fill none
  stroke var(--ui-muted)
  stroke-width 1.15
  stroke-linejoin round
  stroke-linecap round
  vector-effect non-scaling-stroke
.map-boundaries path[data-inferred-boundary]
  stroke-opacity .48
.map-boundaries path.is-selected
  stroke-opacity 1
  stroke var(--boundary-accent, #d0f3ed)
  stroke-width 1.5
.map-city
  cursor pointer
  outline none
.map-city-hit
  fill transparent
.map-city-dot
  opacity 0
  fill var(--ui-accent)
  stroke var(--ui-surface)
  stroke-width 1.3
  vector-effect non-scaling-stroke
.map-city text
  fill var(--ui-ink)
  stroke var(--ui-surface)
  stroke-width 2.5px
  paint-order stroke
  stroke-linejoin round
  visibility hidden
  pointer-events none
.map-city.is-nearby .map-city-dot
  opacity 1
.map-city.show-label text
  visibility visible
  pointer-events auto
.map-city.is-selected .map-city-dot,.map-city:focus .map-city-dot
  opacity 0
  fill var(--ui-ink)
  stroke var(--ui-accent)
  stroke-width 2

.map-area-label
  fill: var(--ui-ink)
  cursor: pointer
  paint-order: stroke
  stroke: var(--ui-surface)
  stroke-width: 3px
  stroke-linejoin: round
  &:hover, &:focus
    fill: var(--ui-accent)


// Day/night values are supplied by the shared pathway palette.
.pathway-page, .pathway-symbol
  --pathway-primary var(--pathway-day, var(--ui-muted))
:root[data-theme="night"] .pathway-page, :root[data-theme="night"] .pathway-symbol
  --pathway-primary var(--pathway-night, var(--ui-muted))
.pathway-symbol
  display inline-block
  width 2rem
  height 2rem
  flex-shrink 0
  color var(--pathway-primary)
  vertical-align middle
.pathway-groups .pathway-symbol-cell
  width 3rem
  text-align center
.pathway-identity
  display flex
  align-items center
  justify-content space-between
  gap 1.5rem
  margin-bottom 1rem
  .pathway-symbol
    width 3.5rem
    height 3.5rem
  h1
    margin 0
.pathway-symbol-credit
  font-size var(--text-meta)
  opacity .75
@media (max-width: 600px)
  .pathway-identity
    gap 1rem
    .pathway-symbol
      width 2.25rem
      height 2.25rem

.map-terrain
  pointer-events none
.map-terrain path
  vector-effect non-scaling-stroke
.map-terrain-mountain
  fill none
  stroke currentColor
  stroke-width .7
  opacity .4
.map-terrain-river
  fill none
  stroke #739eaf
  stroke-width 1
  opacity .8
.map-terrain-plateau
  fill #b8a886
  fill-opacity .07
  stroke none

.map-migration-land path
  fill var(--ui-hover)
  stroke var(--ui-muted)
  stroke-width 1.15
  stroke-linejoin round
  vector-effect non-scaling-stroke

.map-former-boundaries
  pointer-events none
.map-former-boundaries path
  fill none
  stroke var(--ui-muted)
  stroke-opacity .55
  stroke-width 1
  vector-effect non-scaling-stroke
  stroke-linecap round
  stroke-linejoin round

.map-barrier
  cursor pointer
.map-barrier-area
  fill var(--ui-ink)
  fill-opacity .08
.map-barrier-haze,.map-barrier-edge
  fill none
  stroke var(--ui-muted)
  stroke-linejoin round
  stroke-linecap round
.map-barrier-haze
  stroke-width 18
  stroke-opacity .12
.map-barrier-edge
  stroke-width 2
  stroke-opacity .7
.map-barrier text
  fill var(--ui-muted)
  font-size 17px

// Shared collision handling also applies during territorial transitions.
.world-map .map-svg text[data-label-hidden]
  visibility hidden !important
