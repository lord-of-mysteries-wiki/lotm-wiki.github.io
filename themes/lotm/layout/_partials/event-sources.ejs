<% const references = event_references(event); %>
<% if (references.length) { %>
<section class="event-sources"><h2><%= __('event_sources') %></h2>
<ul><% for (const ref of references) { %><li><strong><%= event_reference_scope(ref.scopes) %>：</strong><%= ref.source %></li><% } %></ul>
<% if (compact && event.event_time_basis) { %><p><strong><%= __('event_time_basis') %>：</strong><%= event.event_time_basis %></p><% } %>
</section>
<% } %>
