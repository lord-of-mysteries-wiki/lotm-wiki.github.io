<nav class="site-nav" aria-label="<%= __('nav_label') %>" data-site-navigation data-root="<%= url_for('/') %>" data-day="<%= __('theme_day') %>" data-night="<%= __('theme_night') %>" data-title="<%= config.title %>">
  <a class="site-title" href="<%= url_for('/') %>" aria-label="<%= config.title %>"><span class="site-title-full"><%= config.title %></span><span class="site-title-short" aria-hidden="true">诡秘</span></a>
  <div class="nav-links">
    <% const english = String(page.lang || config.language || '').startsWith('en'); %>
    <% for (const item of site_navigation_items()) { const label = english ? item.en : item.zh; %>
      <a href="<%= url_for('/' + item.path) %>"<% if (item.right) { %> class="nav-link-right"<% } %> aria-label="<%= label %>" title="<%= label %>"><span class="nav-icon" aria-hidden="true"><svg class="wiki-icon" aria-hidden="true" focusable="false"><use href="#wiki-icon-<%= item.icon %>"></use></svg></span><span class="nav-label"><%= label %></span></a>
    <% } %>
  </div>
</nav>
