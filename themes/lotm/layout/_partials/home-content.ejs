<% const sections = [['characters/','home_characters','home_characters_desc','♙'],['relationships/','home_relationships','home_relationships_desc','✣'],['power/','home_power','home_power_desc','✧'],['timeline/','home_timeline','home_timeline_desc','◷'],['artifacts/','home_artifacts','home_artifacts_desc','◇'],['worldview/','home_world','home_world_desc','⊕']]; const featured = [['克莱恩·莫雷蒂','K','home_klein'],['奥黛丽·霍尔','A','home_audrey'],['卢米安·李','L','home_lumian']]; %>
<section class="home-hero"><div class="home-hero-copy"><p class="home-eyebrow">LORD OF THE MYSTERIES</p><h1><%= config.title %></h1><a class="home-primary" href="<%= url_for('/relationships/') %>"><%= __('explore_relationships') %></a></div><div class="home-constellation" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div></section>
<section class="home-section" aria-labelledby="home-explore-title"><div class="home-section-heading"><h2 id="home-explore-title"><%= __('home_explore') %></h2><span>EXPLORE</span></div><div class="home-grid"><% sections.forEach(([path,title,description,icon]) => { %><a class="home-card" href="<%= url_for('/' + path) %>"><span class="home-card-icon" aria-hidden="true"><%= icon %></span><span><strong><%= __(title) %></strong><small><%= __(description) %></small></span></a><% }) %></div></section>
<section class="home-section" aria-labelledby="home-people-title"><div class="home-section-heading"><h2 id="home-people-title"><%= __('home_featured') %></h2><a href="<%= url_for('/characters/') %>"><%= __('home_all_characters') %></a></div><div class="home-people"><% featured.forEach(([name,initial,label]) => { %><a class="home-person" href="<%= url_for('/characters/entries/' + name + '/') %>"><span class="home-person-mark" aria-hidden="true"><%= initial %></span><span><strong><%= __(label) %></strong><small><%= __('home_character_profile') %></small></span></a><% }) %></div></section>
