<%
const records = wiki_events().map(item => {
  const dayWindow = item.event_time_window && item.event_time;
  const cycle = item.event_cordu_cycle ? cordu_cycle_label(item) : '';
  return ({
    id: item.entry_id,
    start: dayWindow ? '' : String(item.event_time || ''), end: dayWindow ? '' : item.event_time_end || '', title: item.title,
    work: item.event_work || '', summary: item.event_summary || '',
    label: (item.event_calendar_label || event_timeline_title(item)) + (cycle ? '（' + cycle.slice('科尔杜'.length) + '）' : ''),
    windowStart: dayWindow ? item.event_time : '', windowEnd: dayWindow ? item.event_time_end : '',
    rangeKind: item.event_range_kind || '',
    summaryParts: event_summary_parts(item).map(part => ({ text: part.text, url: part.target ? url_for('/' + part.target) : '' })),
    period: dayWindow ? item.event_time.slice(0,7) : item.event_time_period || '',
    periodEnd: dayWindow ? item.event_time_end.slice(0,7) : item.event_time_period_end || '',
    note: [cycle, event_date_label(item) || item.event_time_note].filter(Boolean).join(' · '),
    description: strip_html((item.content.match(/<p>([\s\S]*?)<\/p>/) || [])[1] || ''),
    basis: item.event_time_basis || '', references: event_references(item).map(ref => ({source: ref.source, scope: event_reference_scope(ref.scopes)})),
    url: is_brief_event(item) ? '' : url_for('/' + item.path),
    uncertain: item.event_time_uncertain === true
  });
}).sort((a,b) => a.start.localeCompare(b.start) || a.title.localeCompare(b.title,'zh-CN'));
%>
<article class="almanac" data-story-calendar data-count-label="<%= __('calendar_count_label') %>" data-uncertain-label="<%= __('event_time_uncertain_label') %>">
  <header class="almanac-toolbar">
    <%- partial('_partials/timeline-navigation') %>
    <div class="almanac-period">
      <h1 aria-live="polite">故事日历</h1>
      <div><button data-step="-1" aria-label="上一时段"><svg class="wiki-icon" aria-hidden="true" focusable="false"><use href="#wiki-icon-prev"></use></svg></button><button data-step="1" aria-label="下一时段"><svg class="wiki-icon" aria-hidden="true" focusable="false"><use href="#wiki-icon-next"></use></svg></button></div>
    </div>
    <div class="almanac-tools">
      <div role="group" aria-label="日历视图"><button data-mode="day">日</button><button data-mode="week">周</button><button data-mode="month" aria-pressed="true">月</button></div>
      <select aria-label="跳到有事件的月份"><option value="">跳转月份</option></select>
      <button type="button" data-find-events>查找事件</button>
    </div>
  </header>
  <div class="almanac-sheet">
  <div class="almanac-weekdays" aria-hidden="true"><% for (const day of '一二三四五六日') { %><span>周<%=day%></span><% } %></div>
  <div class="almanac-grid"></div>
  </div><dialog class="event-finder" aria-label="查找事件">
    <div class="agenda-head"><label>查找事件<select data-agenda aria-label="事件范围"><option value="period">本期事件</option><option value="all">全部事件</option></select></label>
    <input type="search" aria-label="搜索事件" placeholder="搜索事件名称"><button type="button" data-close-finder>关闭</button></div>
    <div class="agenda-list" tabindex="0"></div>
  </dialog>
  <small data-weekday-note>星期据故事内日期推排</small>
  <noscript>请启用 JavaScript 切换日历视图，或通过时间线阅读事件。</noscript>
  <script type="application/json"><%- JSON.stringify(records).replace(/</g,'\\u003c') %></script>
</article>
