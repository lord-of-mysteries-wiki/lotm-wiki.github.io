<head>
  <% const entryDetail=wiki_is_entry(page) || page.timeline_event || page.creature_profile || /^(?:artifacts|worldview\/countries)\/entries\//.test(String(page.path || '')); %>
  <meta charset="utf-8">
  <% if (page.home) { %><script defer src="<%= url_for('/js/map-geometry.js?v=coast-frame-8') %>"></script><script defer src="<%= url_for('/js/map-data.js?v=coast-frame-8') %>"></script><script defer src="<%= url_for('/js/map-terrain.js') %>"></script><script defer src="<%= url_for('/js/map-transition.js?v=continuous-9') %>"></script><script defer src="<%= url_for('/js/world-map.js?v=coast-frame-13') %>"></script><% } %>
  <% if (page.pathway_page) { %><script defer src="<%= url_for('/js/pathway-page.js') %>"></script><% } %>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="<%= url_for('/favicon.svg') %>">
  <title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
  <% if(page.home){ %><link rel="stylesheet" href="<%= url_for('/css/styles.css?v=inferred-borders-11') %>"><% } else { %><%- css('css/styles') %><% } %>
  <% if (page.relationship_graph) { %>
  <link rel="stylesheet" href="<%= url_for('/relationships/graph.css') %>?v=2">
  <% } %>
  <%- css('css/site-navigation') %>
  <%- css('css/typography') %>
  <%- css('css/motion') %>
  <link rel="stylesheet" href="<%= url_for('/css/wiki-related.css') %>">
  <% if (entryDetail || page.character_profile || page.character_directory || page.artifact_directory || page.organization_directory || page.worldview_directory || page.country_directory || catalog_context(page)) { %>
  <link rel="stylesheet" href="<%= url_for('/css/character-profile.css') %>?v=4">
  <% } %>
  <script src="<%= url_for('/js/site-navigation.js?v=worldview-2') %>"></script>
  <script defer src="<%= url_for('/js/motion.js') %>"></script>
  <% if (entryDetail) { %><link rel="stylesheet" href="<%= url_for('/css/entry-detail.css') %>"><% } %>
  <% if (entryDetail || page.character_profile) { %><script defer src="<%= url_for('/js/character-citations.js') %>"></script><% } %>
  <% if (page.relationship_graph) { %>
  <script defer src="<%= url_for('/relationships/graph-data.js') %>"></script>
  <script defer src="<%= url_for('/relationships/pathway-palette.js') %>"></script>
  <script defer src="<%= url_for('/relationships/group-palette.js') %>"></script>
  <script defer src="<%= url_for('/relationships/relationship-query.js') %>"></script>
  <script defer src="<%= url_for('/relationships/graph.js') %>?v=7"></script>
  <% } %>
  <% if (page.timeline_view) { %>
  <%- css('css/timeline') %>
  <script defer src="<%= url_for(page.timeline_view === 'calendar' ? '/js/story-calendar.js' : '/js/timeline.js') %>"></script>
  <% } %>
  <link rel="stylesheet" href="<%= url_for('/css/wiki-link-hints.css') %>">
  <script defer src="<%= url_for('/js/wiki-link-hints.js') %>" data-site-url="<%= config.url %>" data-internal="<%= __('wiki_link_internal') %>" data-section="<%= __('wiki_link_section') %>" data-external="<%= __('wiki_link_external') %>" data-new-tab="<%= __('wiki_link_new_tab') %>"></script>
  <% if(catalog_context(page)){ %><link rel="stylesheet" href="<%= url_for('/css/catalog.css') %>"><script defer src="<%= url_for('/js/catalog.js') %>"></script><% } %>
</head>
