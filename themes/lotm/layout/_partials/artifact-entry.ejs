<% const view=entry_detail_view(page,'artifact'); %>
<article class="article entry-detail artifact-entry">
  <h1><%= page.title %></h1>
  <div class="entry-body"><%- view.body %></div>
  <%- partial('_partials/wiki-related') %>
  <%- partial('_partials/entry-sources',{view,kind:'artifact'}) %>
</article>
