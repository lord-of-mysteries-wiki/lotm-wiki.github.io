<% const relatedEvents = event_backlinks(page); %>
<% if (relatedEvents.length) { %>
<section class="article">
  <details>
    <summary><%= __('related_timeline_events') %>（<%= relatedEvents.length %>）</summary>
    <ul>
      <% relatedEvents.forEach(function(event) { %>
        <li><a href="<%= url_for('/timeline/') %>#event-<%= encodeURIComponent(event.anchor) %>"><%= event.title %></a><% if (event.date) { %> · <%= event.date %><% } %></li>
      <% }); %>
    </ul>
  </details>
</section>
<% } %>
