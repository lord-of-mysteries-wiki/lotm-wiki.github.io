<% const rows = character_relation_rows(page.entry_id, page.profile_featured_relations); %>
<details id="relationships" class="character-relations">
<summary><%= __('character_relationships') %></summary>
<% if (rows.length) { %><table><thead><tr><th scope="col"><%= __('character_other_person') %></th><th scope="col"><%= __('character_relationship_name') %></th><th scope="col"><%= __('character_relationship_description') %></th></tr></thead><tbody>
<% for (const row of rows) { %><tr><td><a href="<%= url_for('/' + row.person.path) %>"><%= row.person.title %></a></td><td><%= row.label || __('character_unclassified') %></td><td><%= row.description %><%- references.cite(row.source,__('character_relation_scope') + row.person.title) %></td></tr><% } %>
</tbody></table><% } %>
<a class="character-profile__graph" href="<%= url_for('/relationships/') %>?a=<%= encodeURIComponent(page.entry_id) %>"><%= __('character_graph_link') %> ↗</a>
</details>
