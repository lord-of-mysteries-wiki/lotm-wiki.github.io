<% if (references.refs.length) { %><section class="character-sources">
<h2><%= __('character_sources') %></h2><ol>
<% references.refs.forEach((ref,index) => { %><li id="character-source-<%= index+1 %>"><%- references.sourceHTML(ref.source) %><span class="character-source-scopes"><%= [...ref.scopes].join('；') %></span></li><% }); %>
</ol></section><% } %>
