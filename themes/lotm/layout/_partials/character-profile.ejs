<article class="character-profile">
  <header class="character-profile__header">
    <a class="character-profile__back" href="<%= url_for('/characters/') %>">← 返回角色介绍</a>
    <h1><%= page.title %></h1>
    <% if (page.profile_alias && !/^待/.test(page.profile_alias)) { %><p class="character-profile__alias"><%= page.profile_alias %></p><% } %>
  </header>
  <div class="character-profile__layout">
    <aside class="character-profile__facts" aria-label="人物信息">
      <h2>人物信息</h2>
      <dl>
        <% if (page.profile_work && !/^待/.test(String(page.profile_work)) && !(page.profile_facts || []).some(function(fact) { return fact.label === '所属作品' && fact.value && !/^待/.test(String(fact.value)); })) { %>
          <div><dt>所属作品</dt><dd><%= page.profile_work %></dd></div>
        <% } %>
        <% (page.profile_facts || []).forEach(function(fact) {
          const hasSection = fact.source_section && character_has_section(page.content, fact.source_section); %>
          <% if (fact.summary && hasSection) { %>
          <div><dt><%= fact.label %></dt><dd><a href="#<%= encodeURIComponent(fact.source_section) %>"><%= fact.summary %> <span aria-hidden="true">↗</span></a></dd></div>
          <% } else if (fact.value && !/^待/.test(String(fact.value)) && String(fact.value).length <= 80) { %>
          <div><dt><%= fact.label %></dt><dd><%= fact.value %></dd></div>
          <% } else if (hasSection) { %>
          <div><dt><%= fact.label %></dt><dd><a href="#<%= encodeURIComponent(fact.source_section) %>">查看详情 <span aria-hidden="true">↗</span></a></dd></div>
          <% } %>
        <% }); %>
      </dl>
      <a class="character-profile__graph" href="<%= url_for('/relationships/') %>">查看人物关系网 <span aria-hidden="true">↗</span></a>
    </aside>
    <div class="article character-profile__content"><%- page.content %></div>
  </div>
</article>
