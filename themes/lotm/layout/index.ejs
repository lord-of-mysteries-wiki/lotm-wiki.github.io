<% if (page.home) { %>
  <header><%- partial('_partials/navbar') %></header>
  <%- partial('_partials/world-map') %>
<% } else if (page.relationship_graph) { %>
  <%- partial('_partials/relationship-graph') %>
<% } else if (page.timeline_view) { %>
  <header class="story-topbar"><%- partial('_partials/navbar') %></header>
  <main class="story-workspace">
    <%- partial(page.timeline_view === 'calendar' ? '_partials/story-calendar' : '_partials/timeline-preview') %>
  </main>
<% } else { %>
  <header><%- partial('_partials/navbar') %></header>
  <main class="main-content">
    <%- partial('_partials/breadcrumbs') %>
    <%- partial('_partials/catalog-navigation') %>
    <% if (catalog_context(page)?.directory) { %>
      <%- partial('_partials/catalog-page') %>
    <% } else if (page.pathway_page) { %>
      <%- partial('_partials/pathway-page') %>
    <% } else if (page.timeline_event) { %>
      <%- partial('_partials/event-entry') %>
    <% } else if (String(page.path || '').startsWith('artifacts/entries/')) { %>
      <%- partial('_partials/entry-detail', {kind:'artifact'}) %>
    <% } else if (page.creature_profile) { %>
      <%- partial('_partials/entry-detail', {kind:'creature'}) %>
    <% } else if (String(page.path || '').startsWith('worldview/countries/entries/')) { %>
      <%- partial('_partials/entry-detail', {kind:'country'}) %>
    <% } else if (page.character_profile) { %>
      <%- partial('_partials/character-profile') %>
    <% } else if (page.power_overview) { %>
      <%- partial('_partials/power-overview') %>
    <% } else { %>
      <%- partial('_partials/page-template') %>
    <% } %>
  </main>
  <%- partial('_partials/footer') %>
<% } %>
