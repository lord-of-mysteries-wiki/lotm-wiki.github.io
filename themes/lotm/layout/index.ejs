<% if (page.relationship_graph) { %>
  <%- partial('_partials/relationship-graph') %>
<% } else if (page.timeline_view) { %>
  <header class="story-topbar"><%- partial('_partials/navbar') %></header>
  <main class="story-workspace">
    <%- partial(page.timeline_view === 'calendar' ? '_partials/story-calendar' : '_partials/timeline-preview') %>
  </main>
<% } else { %>
  <header><%- partial('_partials/navbar') %></header>
  <main class="main-content">
    <%- partial('_partials/breadcrumbs') %>
    <% if (page.timeline_event) { %>
      <%- partial('_partials/event-entry') %>
    <% } else if (page.character_profile) { %>
      <%- partial('_partials/character-profile') %>
    <% } else if (page.character_directory) { %>
      <%- partial('_partials/character-directory') %>
    <% } else if (page.home) { %>
      <%- partial('_partials/home-content') %>
    <% } else { %>
      <%- partial('_partials/page-template') %>
    <% } %>
  </main>
  <%- partial('_partials/footer') %>
<% } %>
