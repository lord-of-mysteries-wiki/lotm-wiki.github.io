{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "python3 tools/build-character-index.py && node tools/build-timeline-file-index.js",
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "links:preview": "node tools/auto-link-sequences.js",
    "links:apply": "node tools/auto-link-sequences.js --apply",
    "links:check-staged": "node tools/auto-link-sequences.js --check-staged"
  },
  "hexo": {
    "version": "7.2.0"
  },
  "dependencies": {
    "hexo": "^7.0.0",
    "hexo-front-matter": "^4.2.1",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-server": "^3.0.0"
  }
}
